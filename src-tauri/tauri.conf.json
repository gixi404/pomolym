{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomolym",
  "version": "1.0.0",
  "identifier": "com.pomolym.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "focus": true,
        "title": "Pomolym",
        "width": 600,
        "minWidth": 300,
        "height": 500,
        "minHeight": 440,
        "decorations": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Pomolym",
    "shortDescription": "Pomolym",
    "longDescription": "Pomolym is a minimalist Pomodoro",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": null,
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "./assets/banner.webp",
        "dialogImagePath": "./assets/dialog.webp"
      }
    }
  }
}
